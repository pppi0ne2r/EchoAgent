# EchoAgent configuration template.
# Copy this file to echo_agent.toml and edit it for your local environment.
# Environment variables override TOML values.

[server]
# Web UI/API bind address.
host = "127.0.0.1"
port = 8000

# Optional API token. When set, /projects* requires header X-Echo-Agent-Token.
# Recommended when workers run in Docker and can otherwise reach this API on the host.
# auth_token = ""

# SQLite database path. Runtime state under .echo_agent/ should not be committed.
database_path = ".echo_agent/echo_agent.db"

[dispatcher]
# Internal URL used by CLI/dispatcher clients to call the server API.
server_url = "http://127.0.0.1:8000"

# Delay between dispatch-loop steps.
interval_seconds = 3.0

# How many intent threads one project may submit at once. Extra intents wait for a Codex slot.
explore_max_workers = 4

# How many Codex processes one running project may start. This limit is per project.
codex_max_slots = 2

# How many projects may run at the same time. Projects beyond this stay queued and do not start containers.
max_concurrent_projects = 2

[codex]
# Codex CLI command executed inside the project Docker container.
command = ["codex", "exec", "--skip-git-repo-check", "--dangerously-bypass-approvals-and-sandbox", "-"]

# Default and per-mode models.
model = "gpt-5.5"
first_run_model = "gpt-5.5"
explore_model = "gpt-5.5"
reason_model = "gpt-5.5"

# Working directory inside the project container.
workspace = "/home/kali/workspace"

# Wall-clock limit for one Codex invocation.
# While stdout/stderr is still arriving, this limit is deferred.
# A run fails only after no_output_timeout_seconds of silence, unless that
# idle guard is 0. Then this wall-clock limit always applies.
timeout_seconds = 1800

# Optional per-mode overrides. Unset modes fall back to timeout_seconds.
# first_run_timeout_seconds = 1800
# explore_timeout_seconds = 1800
# reason_timeout_seconds = 1800

# Kill Codex if there is no stdout/stderr activity for this many seconds.
# Set to 0 to disable this idle guard and rely only on timeout_seconds.
no_output_timeout_seconds = 900
first_run_no_output_timeout_seconds = 900
explore_no_output_timeout_seconds = 180
reason_no_output_timeout_seconds = 900

# Prefer OPENAI_API_KEY / ECHO_AGENT_OPENAI_API_KEY instead of storing a key here.
api_key = ""
base_url = "https://your-provider.example/v1"

# EchoAgent injects this provider into Codex via "-c model_providers...".
provider_name = "echo_agent_proxy"
supports_websockets = false
request_max_retries = 2
stream_max_retries = 2
stream_idle_timeout_ms = 60000

[docker]
# Worker image build/run settings.
image = "echo-agent-worker"
context = "container"
dockerfile = "container/Dockerfile"
build_network = "host"
# 为 true 时，容器、镜像构建和 Codex 使用系统代理。macOS 读取系统代理，Linux 读取 GNOME 手动代理。也可在配置页修改。
use_system_proxy = false

[resources]
# Host directory for the extension catalog. Tools, knowledge bases, and skills
# are configured in the web UI, not as a second resource list.
root = ".echo_agent/resources"
items = []
